# Neon. App code runs as lejer_app over the pooled endpoint (RLS enforced).
DATABASE_URL=postgresql://lejer_app:...@ep-...-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require
# Owner role, unpooled; table owner, so RLS does not apply. Only scripts/migrate.ts,
# createHousehold(), the cron tick's household enumeration and send-reminders' slug lookup.
DATABASE_URL_ADMIN=postgresql://neondb_owner:...@ep-....us-east-1.aws.neon.tech/neondb?sslmode=require

# jose HS256 key for the lejer_session cookie: openssl rand -base64 32
SESSION_SECRET=

# Resend (login@ and notify@ uselejer.com), from resend.com directly. Outside production an
# empty key means console mode: mail is printed with a [mail:console] prefix, not sent, and
# not logged to email_log. Production refuses to boot without it (instrumentation.ts).
RESEND_API_KEY=
# 1 = send from onboarding@resend.dev (only for a key whose domain isn't verified; unset on Vercel).
# Ignored in production.
# Resend delivers that sender's mail only to the Resend account's own address.
RESEND_TEST_SENDER=

# Private Blob store. On Vercel the SDK uses OIDC; the token is for local dev,
# client-upload token minting and the import script.
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=

# Bearer token for /api/cron/tick; Vercel Cron sends it from the project env (Production).
CRON_SECRET=
# The ten-minute wake-up (lib/wake.ts) is a Vercel Queues message: no variable, the SDK uses
# OIDC on Vercel, and off Vercel (VERCEL unset) scheduleFlush() is a no-op.

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Launch gate: "on" closes the site (coming-soon at /, noindex everywhere, sign-in and invites
# limited to the allowlist). Production only, until launch; anything else is open.
LAUNCH_GATE=
# Comma-separated addresses that may sign in or be invited while gated. Empty = nobody.
SIGNIN_ALLOWLIST=

# Comma-separated addresses that may open /admin (404 for everyone else). Empty = nobody.
SUPERADMIN_EMAILS=

# Dev bypass: sign in as this email in this household slug.
# Ignored when VERCEL_ENV === "production".
APP_DEV_USER=
APP_DEV_HOUSEHOLD=

# npm run verify only runs against the Neon dev branch and the dev Blob store; it checks the
# connection strings and the Blob token against these and refuses anything else.
VERIFY_NEON_PROJECT_ID=
VERIFY_NEON_BRANCH_ID=
VERIFY_NEON_ENDPOINT_ID=
VERIFY_BLOB_STORE_ID=
